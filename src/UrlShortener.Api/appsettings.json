{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=urlshortener.db"
  },
  "RateLimit": {
    "RequestsPerWindow": 100,
    "WindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
